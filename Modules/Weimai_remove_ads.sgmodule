#!name=微脉圈去广告
#!desc=移除开屏广告、聊天页横幅提示及发现页面的横幅广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Weimai.png
#!openUrl=https://apps.apple.com/app/id1427096901
#!tag=去广告
#!system=ios
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!date=2026-06-01 17:11:35

[Script]
body_rewrite_13 = type=http-response, pattern=^https:\/\/confssl\d?\.iweimai\.cn\/wm_ios_update\.json\?, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-replace",[["isShowCJAd",0]]],["json-del",["launchAd","adBanners","ad"]]]

[MITM]
hostname = %APPEND% confssl*.iweimai.cn

