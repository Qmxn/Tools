[Script]
body_rewrite_13 = type=http-response, pattern=^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.adStatementConfig","data.adCustomerRetainArchitecture","data.adImEntryConfig","data.adVenueConfig","data.adPerfSwitch","data.EndNaviC3AdCard","data.infoCpcReport","data.hotsaleConfig","data.marketing_resource_config","data.coupon_risk_asac","data.commonCouponSceneLog","data.sug_coupon_opt","data.giftEntryConfig","data.splashscreen","data.SplashScreenControl","data.splashview_config","data.feedback_banner","data.TrainOrderBanner","data.nearby_business_popup","data.shortcut_popup_frequency","data.tel_retention_popup","data.hotel_activity","data.taxi_activity","data.hotel_privilege","data.sportsActivityConfig","data.activity_qingke_contry_control","data.920bestwishes","data.custom_consultdata.widget_guide","data.free_ride","data.homepage_resource_config","data.home_message_guide","data.hotel_tipsicon","data.sur_bar","data.nearby_map_entry_guide","data.comment_info","data.small_biz_index","data.small_biz_fun","data.setpagesearch","data.wallet"]]]

