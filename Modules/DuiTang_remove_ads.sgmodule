[Map Local]
^https:\/\/xapi\.duitang\.com\/napi\/ads\/\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api-2\.duitang\.com\/napi\/vienna\/daren\/daren\/recommend\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/www\.duitang\.com\/napi\/hot\/search\/list\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
body_rewrite_14 = type=http-response, pattern=^https:\/\/meta\.duitang\.com\/napi\/infra\/settings\/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.AD_LINKS"]]]

body_rewrite_18 = type=http-response, pattern=^https:\/\/api-2\.duitang\.com\/napi\/settings\/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.SPLASH_SWING_OPEN","data.STICKER_SEARCH_HOT_KEYWORDS","data.REWARD_AD_PAG_EDITOR","data.REWARD_AD_PHOTO_EDITOR","data.REWARD_AD_CUTOUT_NUM","data.MAIN_EVENTS","data.QA_TOOLTIP_BOTTOM","data.OC_FOLLOW_OFFICIAL","data.AD_MENU_SELECTIONS","data.FEATURE_TEMPLATES","data.FEEDBACK_URL","data.AVATAR_MALL_UPDATE","data.WATERMARK_MALL_UPDATE","data.OC_MALL_UPDATE","data[\"3D_AVATAR_UPDATE\"]","data.BENEFIT_LIST","data.SHARE_BANNER"]]]

[MITM]
hostname = %APPEND% www.duitang.com, api-2.duitang.com, meta.duitang.com

