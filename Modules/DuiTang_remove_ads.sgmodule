#!name=堆糖去广告
#!desc=移除开屏广告、信息流广告、热搜排行榜广告、我的页面横幅广告，移除关注推荐。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/DuiTang.png
#!openUrl=https://apps.apple.com/app/id533415763
#!tag=去广告
#!loon_version=3.2.4(787)
#!homepage=https://pluginhub.kelee.one
#!date=2025-05-13 15:17:08

[Map Local]
^https:\/\/(www|api)\.duitang\.com\/napi\/(ad|ads)\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.duitang\.com\/napi\/infra\/settings\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.duitang\.com\/napi\/vienna\/daren\/daren\/recommend\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
body_rewrite_16 = type=http-response, pattern=^https:\/\/(www|api)\.duitang\.com\/napi\/settings\/, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.REWARD_AD_PLACES","data.SPLASH_SWING_OPEN","data.REWARD_AD_PHOTO_EDITOR","data.REWARD_AD_PAG_EDITOR","data.AD_PRICE_SHOW","data.AD_SCREEN_WAKEUP_TIME","data.REWARD_AD_CUTOUT_NUM","data.AD_HOME_ENTER_POP_COUNT","data.SHARE_BANNER","data.AD_MENU_SELECTIONS","data.ME_TAB.ANNOUNCEMENT","data.ME_TAB.MEMBERSHIP","data.ME_TAB.MEMBERSHIP2"]]]

[MITM]
hostname = %APPEND% api.duitang.com, www.duitang.com

