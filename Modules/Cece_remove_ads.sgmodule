[Script]
body_rewrite_13 = type=http-response, pattern=^https:\/\/api\.cece\.com\/user\/init\?, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.launch_img_url","data.launch_goto_url"]]]

body_rewrite_14 = type=http-response, pattern=^https:\/\/api\.cece\.com\/common\/app\/app_config\?, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-replace",[["data.is_new_year",false],["data.spring_festival",false],["data.show_feedback_entry",false],["data.show_course_entry",false],["data.show_store_entry",false],["data.show_luna",false],["data.show_ead",false],["data.show_ad",false],["data.show_live_filter_tarot",false],["data.community_feed_adswitch",false],["data.open_screen_ad_times",0],["data.open_screen_ad_duration",0],["data.isShowThumbsGif",false],["data.teenager_mode_open",false],["data.flu_log",false]]],["json-del",["data.activity_list","data.fortune_ab_config"]]]

body_rewrite_23 = type=http-response, pattern=^https:\/\/api\.cece\.com\/common\/app\/risk_entrance\?, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-replace",[["data.ai_fortune_show_ask_tool",false],["data.ai_sign_show_ask_tool",false],["data.single_tool_show_dice_card",false],["data.single_tool_show_tarot_card",false],["data.single_tool_show_bazi_card",false],["data.single_tool_show_hepan_card",false],["data.single_tool_show_ziwei_card",false],["data.single_tool_show_xingpan_card",false],["data.multi_tool_show_card",false],["data.ai_ccai_show_multi_tool",false]]]]

[MITM]
hostname = %APPEND% api.cece.com

