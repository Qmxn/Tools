#!name=5EPlay去广告
#!desc=移除开屏广告、弹窗广告、活动角标、商城。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/5EPlay.png
#!openUrl=https://apps.apple.com/app/id1149334962
#!tag=去广告
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!date=2026-08-24 18:59:19

[Map Local]
^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
body_rewrite_13 = type=http-response, pattern=^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\?, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.function_configs.startup_ad_switch","data.function_configs.startup_ad_timeout","data.function_configs.startup_ad_day_max","data.function_configs.app_bar_guide_width","data.function_configs.app_bar_guide_height","data.function_configs.app_bar_guide_url","data.function_configs.app_bar_guide_time","data.function_configs.home_tab_event_tag","data.function_configs.home_tab_event_tag_ext","data.function_configs.home_tab_player_tag","data.function_configs.home_tab_player_tag_ext","data.function_configs.task_center_entrance","data.function_configs.store_go","data.function_configs.wall_closed"]]]

body_rewrite_14 = type=http-response, pattern=^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.float_advertise"]]]

body_rewrite_16 = type=http-response, pattern=^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["data.placeholder"]]]

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com

