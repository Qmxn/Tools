[URL Rewrite]
^https:\/\/god\.gameyw\.netease\.com\/v\d\/ad - reject

[Script]
body_rewrite_13 = type=http-response, pattern=^https:\/\/app-conf\.ds\.163\.com\/v1\/app\/base\/conf\/static\/start-config\?, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["replace-regex",[["\\{\"os\":\"all\",\"weight\":50\\.0,\"hidden\":false,\"name\":\"游戏\"\\},\\{\"os\":\"all\",\"weight\":50\\.0,\"hidden\":false,\"name\":\"频道\"\\},","null"]]]]

[MITM]
hostname = %APPEND% god.gameyw.netease.com, app-conf.ds.163.com

