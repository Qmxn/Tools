#!name=美丽修行去广告
#!desc=移除开屏广告、首页广告、发现页广告、美修盒页面广告、下拉广告、弹窗广告、搜索推广、版本更新弹窗及我的页面广告。
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Meizhixiuxing.png
#!openUrl=https://apps.apple.com/app/id1089854728
#!tag=去广告
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!date=2026-06-01 17:11:35

[Map Local]
^https:\/\/api\.bevol\.com\/appmain\/app\/home\/launch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.bevol\.com\/appmain\/app\/home\/popup$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.bevol\.com\/personal\/page$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/api\.bevol\.com\/seach\/foundAndTopSearch$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
body_rewrite_16 = type=http-response, pattern=^https:\/\/api\.bevol\.com\/appmain\/app\/home\/page$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["result.versionPopUp","result.isShowSearchLabel","result.isShowSearchFeedBack","result.centerBannerAdvert","result.programmaticAdvertising","result.mattsData","result.questionnaireMap","result.appPullDownAdvert"]]]

body_rewrite_17 = type=http-response, pattern=^https:\/\/api\.bevol\.com\/appmain\/app\/home\/feed$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["result.banners"]]]

body_rewrite_19 = type=http-response, pattern=^https:\/\/api\.bevol\.com\/trialbox\/shop\/app\/homePage$, script-path=https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=[["json-del",["result.firstPersonActivity","result.mainActivity","result.brandZone","result.imageAD2","result.couponPopupInfo"]]]

[MITM]
hostname = %APPEND% api.bevol.com

